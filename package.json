{
  "name": "spine-codex-pet-converter",
  "version": "1.1.0",
  "private": true,
  "description": "Convert Spine 3.8 character assets into Codex desktop-pet sprite sheets.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build:icon": "node scripts/build-icon.mjs",
    "build:desktop": "node desktop/build-desktop.mjs",
    "package:desktop": "powershell -ExecutionPolicy Bypass -File ./package-desktop.ps1",
    "package:legacy": "powershell -ExecutionPolicy Bypass -File ./scripts/package-legacy-v1.0.0.ps1",
    "convert": "node scripts/convert-spine.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "esbuild": "0.25.9",
    "pixi-spine": "4.0.6",
    "pixi.js": "7.4.3",
    "puppeteer-core": "24.19.0",
    "sharp": "0.34.3"
  },
  "packageManager": "pnpm@11.19.0"
}
