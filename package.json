{
  "name": "spine-codex-pet-converter",
  "version": "1.1.0",
  "private": true,
  "description": "Convert Spine 3.8 character assets into Codex desktop-pet sprite sheets.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron src/app",
    "check": "node scripts/check.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "package:desktop": "powershell -ExecutionPolicy Bypass -File ./scripts/package-desktop.ps1",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "pixi-spine": "4.0.6",
    "pixi.js": "7.4.3"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "esbuild": "0.25.9",
    "sharp": "0.34.3"
  },
  "packageManager": "pnpm@11.19.0"
}
